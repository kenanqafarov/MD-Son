server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types text/plain text/css text/javascript application/json application/javascript image/svg+xml;

    # SPA: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The service worker and its manifest must never be cached, or clients keep an old build
    location ~* ^/(sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Uploaded patient files, shared volume with the backend
    location /media/ {
        alias /app/media/;
        autoindex off;
        expires 30d;
        try_files $uri =404;
    }

    location /api/ {
        # Same-origin calls need no CORS check; dropping Origin means the backend
        # does not have to list every IP/hostname the clinic opens the app on.
        # Requests from any other origin keep their header and stay CORS-checked.
        set $api_origin $http_origin;
        if ($http_origin = "$scheme://$http_host") {
            set $api_origin "";
        }
        proxy_set_header Origin $api_origin;

        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
